{
  "manifest_version": 3,
  "name": "ViewFit · 随屏",
  "version": "1.0.1",
  "description": "跟随「ViewFit · 随屏」菜单栏应用，按外接显示器配置自动调整网页缩放。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "ViewFit · 随屏", "default_popup": "popup.html" }
}
